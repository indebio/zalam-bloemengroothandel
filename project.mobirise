            },
            ".stats-item a": {
              "color": "inherit !important",
              "transition": "transform 0.1s ease-in-out"
            },
            ".stats-item a:active": {
              "transform": "scale(0.95)",
              "color": "inherit !important"
            },
            ".stats-item a:hover": {
